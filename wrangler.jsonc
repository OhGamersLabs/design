{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohgamers-design",
  "main": "worker/index.js",
  "account_id": "9ef45508273746d6ed19ac93e11b76b1",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "docs/.vitepress/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media", "/media/*"]
  },
  "r2_buckets": [
    { "binding": "PUBLIC_RELEASES", "bucket_name": "ohgamers" }
  ],
  "routes": [
    { "pattern": "design.ohgamers.org", "custom_domain": true }
  ]
}
